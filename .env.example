# Local development defaults
APP_ENV=development
APP_API_KEY=

# Local Ollama runtime and model tags
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEXT_MODEL=qwen2.5:3b
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_NUM_PREDICT=3072
OLLAMA_NUM_CTX=8192

# OCR
OCR_ENABLED=true
OCR_CROSSCHECK=true
OCR_LANGUAGE=eng
TESSERACT_CMD=

# Local storage
MAX_UPLOAD_MB=30
DATABASE_PATH=data/docintel.sqlite3

# Optional Fernet key for supported encrypted SQLite data.
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
